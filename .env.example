# Environment variable names used by this exercise. Names only: never put a real value in this file.
# Copy to .env in the repository root and fill in locally; .env is git-ignored and never committed.
# Replay (the default) needs none of these to be set.

# --- Application and grader ---
# Gemini API key. Needed only for QA_MODE=record and for reference/judge.py (live calls).
# The google-genai SDK also reads GEMINI_API_KEY by itself; if both are set, GOOGLE_API_KEY wins.
GOOGLE_API_KEY=
# replay (default: saved responses, no key) or record (calls the model for requests with no saved response).
QA_MODE=
# Folder for the workspace state file (default: state/, git-ignored).
QA_STATE_DIR=

# --- Developer only: NOT for .env ---
# QA_ALLOW_REFERENCE_EDIT=1 is set in the shell for the one session that writes the answer key under reference/.
# Only the Claude Code hook .claude/hooks/protect_paths.py reads it; the application never does.
# QA_ALLOW_REFERENCE_EDIT=
